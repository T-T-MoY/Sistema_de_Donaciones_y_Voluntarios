# ============================================================
# VARIABLES DE ENTORNO - BACKEND (Producción en Render)
# ============================================================
# Copia este archivo como .env en desarrollo local.
# En Render, configura cada variable en el panel Environment.

# ---- Servidor ----
PORT=4000
NODE_ENV=production

# ---- Base de Datos PostgreSQL (Neon) ----
# Pega aquí el "Connection string" de Neon (formato pooled)
DATABASE_URL=postgresql://usuario:password@ep-xxxx.us-east-1.aws.neon.tech/bd_donaciones_voluntariado?sslmode=require

# ---- Seguridad ----
JWT_SECRET=cambia_este_valor_por_uno_seguro_en_produccion

# ---- Email (Brevo API HTTPS) ----
BREVO_API_KEY=tu_api_key_de_brevo
EMAIL_USER=soportecanchas0@gmail.com
EMAIL_FROM_NAME=Donaciones y Voluntarios

# ---- Frontend (para CORS y emails) ----
FRONTEND_URL=https://tu-app.vercel.app
